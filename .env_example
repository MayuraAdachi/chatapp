# サンプル環境変数ファイル
# 必要に応じて値を設定し、.envとしてコピーして使用してください

DEBUG_MODE=True
# SECRET_KEYはランダムな英数字32文字以上を推奨
# 下記コマンド実行で作成可能
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

# 使用するDBに応じて、下記のDATABASE_URLのコメントを切り替えてください
# PostgreSQL（開発・本番用で分ける）
DB_USER=chatapp_user
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatapp_db
DATABASE_URL=postgresql+psycopg2://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
